FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nuTilda;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 4.5e-05;

boundaryField
{
    airfoil
    {
        type            fixedValue;
        value           uniform 0;
    }

    inlet
    {
        type            freestream;
        freestreamValue uniform 4.5e-05;
    }

    top
    {
        type            freestream;
        freestreamValue uniform 4.5e-05;
    }

    bottom
    {
        type            freestream;
        freestreamValue uniform 4.5e-05;
    }

    outlet
    {
        type            freestream;
        freestreamValue uniform 4.5e-05;
    }

    frontAndBack
    {
        type            empty;
    }
}
